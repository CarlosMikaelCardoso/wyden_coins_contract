# Configurações do Nó Local Hyperledger Besu
NODE_NAME=besu-node1
NODE_IP=<ip-node>
P2P_PORT=30303
BESU_IMAGE=hyperledger/besu:25.5.0
BESU_LOGGING=INFO

# Argumentos completos de inicialização do Besu para este nó
BESU_ARGS=--data-path=/opt/besu/data --genesis-file=/opt/besu/genesis.json --p2p-port=30303 --p2p-host=<ip-node> --min-gas-price=0 --data-storage-format=BONSAI --profile=ENTERPRISE --permissions-nodes-config-file=/opt/besu/permissions_config.toml --permissions-accounts-config-file=/opt/besu/permissions_config.toml
